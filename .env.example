# Copy to .env before running `docker compose up`. Compose reads .env from
# this directory automatically — never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:1995
HOST_PORT=1995

# Leave unset/false for the default plain-HTTP setup (LAN IP, localhost, a
# VPS reached over http://). Only set to "true" once this app is actually
# served over HTTPS (a reverse proxy, a Cloudflare Tunnel, etc.) — the
# session cookie is marked Secure when this is true, and browsers silently
# refuse to store a Secure cookie on a plain http:// origin, which locks
# every user out with "Unauthorized" even though login appears to succeed.
COOKIE_SECURE=false

# Optional: makes THIS server a sync hub that Windows/desktop installs can
# two-way sync with (Settings → Server Sync on the other PC). Use a long random
# value (openssl rand -hex 24) and leave unset on installs that are not the hub.
# SYNC_API_KEY=

# --- Website integration (docs/website-integration.md) ---------------------
# Served over HTTPS through a Cloudflare Tunnel, e.g. https://api.example.com:
#   COOKIE_SECURE=true
#   FRONTEND_ORIGIN=https://api.example.com   # comma-separate to allow several exact origins
# Trusted proxy hops (a number, never "true"). 1 = web container in front, correct only
# when ALL traffic comes through the tunnel (see docs/website-integration.md).
# TRUST_PROXY=
# Per-API-key rate limits (requests/minute) for the Integration API.
# INTEGRATION_WRITE_LIMIT_PER_MIN=30
# INTEGRATION_READ_LIMIT_PER_MIN=300
# The tunnel token (only if cloudflared runs as a compose service). Never commit it.
# CLOUDFLARE_TUNNEL_TOKEN=
# The website's own backend env (NOT this file; server-side only):
#   ORDERRESTRO_URL=https://api.example.com
#   ORDERRESTRO_API_KEY=ordr_ext_...
#   ORDER_COOKIE_SECRET=<openssl rand -hex 32>
