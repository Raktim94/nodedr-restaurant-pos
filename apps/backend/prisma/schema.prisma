// Nodedr OrderRestro — Phase 0/1 core schema.
// See ARCHITECTURE.md for why PostgreSQL is the primary target and how
// multi-branch/single-location both map onto the same schema (a branch is
// just a Branch row, not a different deployment mode).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / Branch
// ---------------------------------------------------------------------------

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")

  // Loyalty program config — previously hardcoded constants in
  // OrdersService, now per-restaurant and settings-editable. Point value
  // is the currency amount 1 redeemed point is worth; earn rate is how
  // many currency units of net spend earn 1 point (floor division).
  loyaltyPointValue     Decimal @default(1) @db.Decimal(6, 2)
  loyaltyEarnPerCurrency Int    @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  roles    Role[]
  users    User[]

  @@map("restaurants")
}

model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  phone     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors          Floor[]
  users           UserBranch[]
  menuItems       MenuItem[]
  categories      MenuCategory[]
  stations        KitchenStation[]
  orders          Order[]
  customers       Customer[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  giftCards       GiftCard[]
  ingredients     Ingredient[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockBatches    StockBatch[]
  stockMovements  StockMovement[]
  wasteLogs       WasteLog[]

  @@index([restaurantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum StaffRoleName {
  OWNER
  ADMINISTRATOR
  RESTAURANT_MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
  CHEF
  BARTENDER
  DELIVERY_STAFF
  ACCOUNTANT
  INVENTORY_MANAGER
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "orders.create", "menu.manage"
  label    String
  category String // grouping for the settings UI, e.g. "Orders", "Inventory"

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      StaffRoleName
  label     String
  isSystem  Boolean       @default(true) // seeded default role vs. custom role
  createdAt DateTime      @default(now())

  permissions RolePermission[]
  users       User[]

  @@unique([restaurantId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  name            String
  email           String?
  phone           String?
  passwordHash    String
  pinHash         String? // quick-switch PIN login on a shared terminal
  isActive        Boolean @default(true)
  twoFactorSecret String? // set once 2FA is enabled (Phase 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      UserBranch[]
  waiterTables  Table[]      @relation("TableWaiter")
  ordersCreated Order[]      @relation("OrderCreatedBy")
  auditLogs     AuditLog[]
  refundsIssued Refund[]

  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  goodsReceiptsReceived GoodsReceipt[]  @relation("GoodsReceiptReceivedBy")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  wasteLogsCreated      WasteLog[]      @relation("WasteLogCreatedBy")

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("users")
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Floor & Table management
// ---------------------------------------------------------------------------

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

model Floor {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  tables Table[]

  @@index([branchId])
  @@map("floors")
}

model Table {
  id      String @id @default(cuid())
  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  number   String
  name     String?
  capacity Int         @default(2)
  status   TableStatus @default(AVAILABLE)

  // Floor designer layout — percentage-based so any canvas size renders consistently
  posX     Float   @default(0)
  posY     Float   @default(0)
  width    Float   @default(80)
  height   Float   @default(80)
  rotation Float   @default(0)
  shape    String  @default("square") // square | round | rect
  color    String?

  assignedWaiterId String?
  assignedWaiter   User?   @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)

  notes   String?
  qrToken String? @unique // opaque token embedded in the table's QR code (Phase 2+)

  orders          Order[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorId, number])
  @@index([floorId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Menu management
// ---------------------------------------------------------------------------

model MenuCategory {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items MenuItem[]

  @@index([branchId])
  @@map("menu_categories")
}

model KitchenStation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String // e.g. "Main Kitchen", "Tandoor", "Bar", "Dessert Station"
  printerName String?

  items MenuItem[]
  kots  Kot[]

  @@index([branchId])
  @@map("kitchen_stations")
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

// ---------------------------------------------------------------------------
// Inventory & Store Management (Phase 4)
//
// Deliberate scope-cut vs. the full spec ("units + unit conversion"): each
// Ingredient has ONE base unit, used consistently for its recipe quantities,
// PO/GRN quantities, and stock. A real conversion engine (buy a 25kg bag,
// stock/recipe in kg) is deferred — see ROADMAP.md — rather than guessed at.
//
// Costing is weighted-average (WAC), recomputed on every GRN receipt:
// newCost = ((oldStock * oldCost) + (receivedQty * receivedCost)) /
// (oldStock + receivedQty). Ingredient.currentStock/costPerUnit are cached
// columns, but NEVER mutated with a DB `increment` — same float-drift lesson
// nodedr-pos learned the hard way (see its project memory): every mutation
// reads the current value, computes the new one in JS with round4, and
// `set`s it inside the same transaction as the StockMovement ledger row.
// StockMovement is the append-only source of truth; the cached columns are
// a read optimization that must always be derivable by summing it.
// ---------------------------------------------------------------------------

enum IngredientUnit {
  KG
  G
  L
  ML
  PIECE
  DOZEN
  PACK
  BOX
}

model Ingredient {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name         String
  sku          String?
  unit         IngredientUnit
  reorderLevel Decimal        @default(0) @db.Decimal(12, 3)

  // Cached from the StockMovement ledger — see note above on why these are
  // safe (transactional read-then-set, never `increment`).
  currentStock Decimal @default(0) @db.Decimal(12, 3)
  costPerUnit  Decimal @default(0) @db.Decimal(12, 4) // weighted-average cost

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeLines        RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockBatches       StockBatch[]
  stockMovements     StockMovement[]
  wasteLogs          WasteLog[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("ingredients")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantity  Decimal  @db.Decimal(12, 3) // in ingredient.unit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@map("recipe_ingredients")
}

model Supplier {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@index([branchId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)

  createdById String
  createdBy   User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([branchId, poNumber])
  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantityOrdered  Decimal @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 4)
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  grnNumber String
  notes     String?

  receivedById String
  receivedBy   User     @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  items GoodsReceiptItem[]

  @@unique([branchId, grnNumber])
  @@index([branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  quantity    Decimal   @db.Decimal(12, 3)
  unitCost    Decimal   @db.Decimal(12, 4)
  batchNumber String
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  stockBatch StockBatch?

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

model StockBatch {
  id           String     @id @default(cuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  goodsReceiptItemId String?           @unique
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  batchNumber       String
  quantityReceived  Decimal   @db.Decimal(12, 3)
  quantityRemaining Decimal   @db.Decimal(12, 3)
  unitCost          Decimal   @db.Decimal(12, 4)
  expiryDate        DateTime?
  receivedAt        DateTime  @default(now())

  stockMovements StockMovement[]
  wasteLogs      WasteLog[]

  @@index([branchId, ingredientId, receivedAt])
  @@map("stock_batches")
}

enum StockMovementType {
  RECEIPT
  WASTE
  ADJUSTMENT
  CONSUMPTION
}

model StockMovement {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 3) // signed: +in, -out
  note     String?

  createdById String
  createdBy   User     @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@map("stock_movements")
}

enum WasteReason {
  EXPIRED
  SPOILED
  DAMAGED
  PREP_ERROR
  OVER_PRODUCTION
  OTHER
}

model WasteLog {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  quantity        Decimal     @db.Decimal(12, 3)
  reason          WasteReason
  unitCostAtWaste Decimal     @db.Decimal(12, 4)
  notes           String?

  createdById String
  createdBy   User     @relation("WasteLogCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@map("waste_logs")
}

model MenuItem {
  id         String          @id @default(cuid())
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  stationId  String?
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  name        String
  sku         String?
  description String?
  imageUrl    String?

  price          Decimal  @db.Decimal(12, 2) // tax-inclusive selling price (see nodedr-pos GST lesson in ARCHITECTURE.md)
  taxRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  prepTimeMinutes Int?
  calories        Int?
  isVeg           Boolean    @default(true)
  isVegan         Boolean    @default(false)
  isJain          Boolean    @default(false)
  isHalal         Boolean    @default(false)
  isGlutenFree    Boolean    @default(false)
  spiceLevel      SpiceLevel @default(NONE)
  allergens       String[]   @default([])

  availableFrom String? // "HH:mm" — availability window
  availableTo   String?
  isSeasonal    Boolean   @default(false)
  seasonStart   DateTime?
  seasonEnd     DateTime?

  barcode  String?
  isActive Boolean @default(true)
  isCombo  Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modifierGroups  MenuItemModifierGroup[]
  orderItems      OrderItem[]
  comboComponents ComboComponent[]        @relation("ComboParent")
  usedInCombos    ComboComponent[]        @relation("ComboChild")
  recipeLines     RecipeIngredient[]

  @@index([branchId, categoryId])
  @@map("menu_items")
}

model ModifierGroup {
  id         String  @id @default(cuid())
  name       String // e.g. "Crust Type", "Extras"
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  isRequired Boolean @default(false)

  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name            String // e.g. "Extra Cheese", "No Onion"
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  taxRatePercent  Decimal? @db.Decimal(5, 2)
  kitchenNote     String?
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)

  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

model MenuItemModifierGroup {
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ---------------------------------------------------------------------------
// Customers (minimal Phase 1 shape — full CRM lands Phase 3)
// ---------------------------------------------------------------------------

model Customer {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String?
  phone       String?
  email       String?
  address     String?
  birthday    DateTime?
  anniversary DateTime?
  allergies   String?
  notes       String?

  loyaltyPoints Int     @default(0)
  walletBalance Decimal @default(0) @db.Decimal(12, 2) // store credit

  createdAt DateTime   @default(now())
  orders    Order[]
  giftCards GiftCard[]

  @@index([branchId, phone])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Gift cards & combos (Phase 3)
// ---------------------------------------------------------------------------

model GiftCard {
  id           String    @id @default(cuid())
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code         String    @unique
  initialValue Decimal   @db.Decimal(12, 2)
  balance      Decimal   @db.Decimal(12, 2)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions GiftCardRedemption[]

  @@index([branchId])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@map("gift_card_redemptions")
}

model ComboComponent {
  id              String   @id @default(cuid())
  comboItemId     String
  comboItem       MenuItem @relation("ComboParent", fields: [comboItemId], references: [id], onDelete: Cascade)
  componentItemId String
  componentItem   MenuItem @relation("ComboChild", fields: [componentItemId], references: [id])
  quantity        Int      @default(1)

  @@unique([comboItemId, componentItemId])
  @@map("combo_components")
}

// ---------------------------------------------------------------------------
// Orders / KOT / Payments
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  DRIVE_THRU
  QR_ORDER
  KIOSK
  PHONE
}

enum OrderStatus {
  OPEN
  BILLED
  PAID
  CANCELLED
}

model Order {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orderNumber String // human-readable, sequential per branch per day
  type        OrderType   @default(DINE_IN)
  status      OrderStatus @default(OPEN)

  tableId    String?
  table      Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestCount Int?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  subtotal              Decimal @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal @default(0) @db.Decimal(12, 2) // informational breakup only — see ARCHITECTURE.md inclusive-pricing note
  tipAmount             Decimal @default(0) @db.Decimal(12, 2)
  loyaltyPointsRedeemed Int     @default(0)
  loyaltyDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  billedAt  DateTime?

  items               OrderItem[]
  kots                Kot[]
  payments            Payment[]
  giftCardRedemptions GiftCardRedemption[]
  refunds             Refund[]

  @@unique([branchId, orderNumber])
  @@index([branchId, status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  // Snapshotted at order time so later menu edits never rewrite history
  // (same discipline as nodedr-pos snapshotting name/taxRate/unit onto InvoiceItem).
  nameSnapshot      String
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  taxRateSnapshot   Decimal @db.Decimal(5, 2)

  quantity    Int           @default(1)
  lineTotal   Decimal       @db.Decimal(12, 2)
  kitchenNote String?
  status      KotItemStatus @default(NEW)

  modifiers OrderItemModifier[]
  kotItems  KotItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String
  modifier    Modifier  @relation(fields: [modifierId], references: [id])

  nameSnapshot     String
  priceAdjSnapshot Decimal @db.Decimal(12, 2)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Kitchen Order Tickets
// ---------------------------------------------------------------------------

enum KotStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KotItemStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Kot {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  ticketNumber String
  status       KotStatus @default(NEW)
  isPriority   Boolean   @default(false)
  printedCount Int       @default(0)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  readyAt    DateTime?
  servedAt   DateTime?

  items KotItem[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("kots")
}

model KotItem {
  id          String    @id @default(cuid())
  kotId       String
  kot         Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  status KotItemStatus @default(NEW)

  @@index([kotId])
  @@map("kot_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  BANK_TRANSFER
  GIFT_CARD
  STORE_CREDIT
}

// ---------------------------------------------------------------------------
// Reservations & Waitlist (Phase 2)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  RESERVED
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerName    String
  phone           String?
  email           String?
  guestCount      Int
  reservedAt      DateTime
  durationMinutes Int      @default(90)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  specialRequests String?
  deposit         Decimal?          @db.Decimal(12, 2)
  status          ReservationStatus @default(RESERVED)
  reminderSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, reservedAt])
  @@map("reservations")
}

enum WaitlistStatus {
  WAITING
  SEATED
  CANCELLED
}

model WaitlistEntry {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerName      String
  phone             String?
  partySize         Int
  quotedWaitMinutes Int?
  notes             String?
  status            WaitlistStatus @default(WAITING)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  seatedAt  DateTime?

  @@index([branchId, status])
  @@map("waitlist_entries")
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // gateway/UPI txn ref
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(12, 2)
  reason      String?
  method      PaymentMethod // how the refund was issued back to the guest
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@map("refunds")
}
